# Copy this file to .env and fill in your local values.

# Autodesk Platform Services
APS_CLIENT_ID="your-client-id-here"
APS_CLIENT_SECRET="your-client-secret-here"
APS_CALLBACK_URL="http://localhost:8000/api/auth/callback"

# Session
SERVER_SESSION_SECRET="change-this-to-a-long-random-session-secret"

# Runtime
NODE_ENV=development
PORT=8000

# Optional AI provider
AI_PROVIDER=gemini
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=""
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional project overrides
GANGBUK_HUB_ID="b.4efd43ab-93fa-4448-918b-091d81dbfd75"
GANGBUK_PROJECT_ID="b.d005cd39-4a35-4843-b350-81da491266ef"